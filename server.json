{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.recomma/recomma",
  "title": "Recomma",
  "description": "What ChatGPT, Gemini and Google AI Overviews say about your brand, and which sources they cite",
  "version": "1.0.0",
  "websiteUrl": "https://docs.recomma.ai/reference/mcp",
  "repository": {
    "url": "https://github.com/RecommaAI/recomma",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/RecommaAI/recomma/main/extension/icons/icon128.png",
      "mimeType": "image/png",
      "sizes": [
        "128x128"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.recomma.ai/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Optional. Bearer recomma_… API key from Settings → Connect AI. Without it, the client signs in with OAuth.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
